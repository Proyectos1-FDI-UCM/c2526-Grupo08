/*
  FeedbackUI.uss
  Tarjetas de feedback visual ingame (pickup, puerta).
  Paleta del GDD.
*/

.feedback-root {
    position: absolute;
    left: 24px;
    bottom: 100px;
    width: 360px;
    flex-direction: column;
    align-items: flex-start;
}

.feedback-card {
    background-color: rgba(31, 55, 56, 0.95);
    border-color: #2f7a74;
    border-width: 2px;
    border-radius: 8px;
    padding: 12px 18px;
    margin-bottom: 8px;
    flex-direction: row;
    align-items: center;
    min-width: 340px;
    min-height: 80px;
    opacity: 0;
    translate: -30px 0;
    transition-property: opacity, translate;
    transition-duration: 0.25s;
    transition-timing-function: ease-out;
}

.feedback-card--visible {
    opacity: 1;
    translate: 0 0;
}

.feedback-card--locked {
    border-color: #e0c060;
    background-color: rgba(40, 32, 15, 0.95);
}

.feedback-card--unlocked {
    border-color: #79e2d6;
    background-color: rgba(18, 45, 45, 0.95);
}

.feedback-card--pickup {
    border-color: #3bb4a8;
}

.feedback-icon {
    width: 64px;
    height: 64px;
    margin-right: 14px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.feedback-text-col {
    flex-direction: column;
    flex-grow: 1;
    justify-content: center;
}

.feedback-label {
    color: #d4f0ee;
    font-size: 16px;
    -unity-font-style: bold;
}

.feedback-sublabel {
    color: #7aadaa;
    font-size: 13px;
    margin-top: 2px;
}