MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 31857258}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0420ebc707c83174c960b53292cb71fd, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  DialogueBox: {fileID: 1303141874}
  CharacterImage: {fileID: 1396418252}
  SpeakerNameText: {fileID: 2048709940}
  DialogueText: {fileID: 1115419592}
  ContinueHint: {fileID: 1550542861}
  DialogueLines:
  - SpeakerName: Narrador
    CharacterSprite: {fileID: 0}
    Text: "Tras una ardua batalla, Cori not\xF3 un movimiento por el rabillo del
      ojo. El hombre gravemente herido intentaba incorporarse, tocando botones de
      un aparato oculto bajo su chaleco."
  - SpeakerName: Cori
    CharacterSprite: {fileID: 1027435269764664986, guid: d934b63d131c7124db8582d01f09497c, type: 3}
    Text: "\xBFQu\xE9 te cre\xEDas, que no te iba a ver? Tienes que ser primerizo
      para hacer algo tan imb\xE9cil. Dime qu\xE9 hac\xEDas. Ahora."
  - SpeakerName: Soldado
    CharacterSprite: {fileID: -7344043376728424638, guid: e0a4f349fa433fd478739e6bc4e51d27, type: 3}
    Text: "\xA1La jefa\u2026! Hablaba\u2026 Iba a hablar con la jefa."
  - SpeakerName: Cori
    CharacterSprite: {fileID: -7301773207540950569, guid: 72037d277700fa24e8c1fc8a447e6b53, type: 3}
    Text: "\xBFCon que la jefa, eh? Yo tambi\xE9n quiero \"hablar\" con ella. Tiene
      un bot\xEDn que me interesa."
  - SpeakerName: Soldado
    CharacterSprite: {fileID: 3697559366838435654, guid: 1e0da763a9664e64da0363069d0a79af, type: 3}
    Text: Me niego. Si digo algo que no debo, estoy muerto.
  - SpeakerName: Cori
    CharacterSprite: {fileID: 1027435269764664986, guid: d934b63d131c7124db8582d01f09497c, type: 3}
    Text: "\xBFY? Ya lo est\xE1s de todas formas."
  - SpeakerName: Soldado
    CharacterSprite: {fileID: -5895514099515216418, guid: 7bcfeaefa10580543a4212e6aae22f21, type: 3}
    Text: "Ese tono que tanto odio\u2026 Me recuerdas a mi jefa."
  - SpeakerName: Cori
    CharacterSprite: {fileID: 1027435269764664986, guid: d934b63d131c7124db8582d01f09497c, type: 3}
    Text: "\xBFPero me vas a decir d\xF3nde est\xE1 o no? Esta es tu \xFAltima oportunidad."
  - SpeakerName: Soldado
    CharacterSprite: {fileID: 3697559366838435654, guid: 1e0da763a9664e64da0363069d0a79af, type: 3}
    Text: "No te puedo decir d\xF3nde est\xE1. Pero en la sala de reuniones del final
      a la izquierda estuvo esta ma\xF1ana y anot\xF3 algunas cosas. No s\xE9 si
      te servir\xE1n de algo."
  - SpeakerName: Cori
    CharacterSprite: {fileID: -2645759636355516012, guid: a1a25fa1f46f3f44db865326beafdefa, type: 3}
    Text: "No s\xE9 de qui\xE9n se est\xE1 burlando este cretino. Si de la jefa...
      o de m\xED."
  HintText: "F  /  B (mando)  \u2192  continuar"
